# Safe Start API — copy to .env and fill in real values.

# PostgreSQL (Supabase session pooler, port 5432)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

PORT=3000
NODE_ENV=development

# Comma-separated origins in production — never use *
# Example: CORS_ORIGINS=https://dashboard.safestartdrivers.com.au,https://safestartdrivers.com.au
CORS_ORIGINS=*

# Required in production; min 32 chars. Optional in development (see src/partner/credentials.ts).
PARTNER_API_SIGNING_KEY=your-partner-api-signing-key-min-32-chars

# Optional: path to Chrome/Edge for PDF export (Puppeteer)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Dev-only scripts (never use in production)
# Password for npm run seed:dashboard-users
DASHBOARD_DEV_PASSWORD=choose-a-strong-dev-password

# Credentials for npx tsx test-auth.ts
TEST_AUTH_EMAIL=test@example.com
TEST_AUTH_PASSWORD=choose-a-strong-dev-password
# Set to true to print the JWT to stdout (dev only)
TEST_AUTH_PRINT_TOKEN=false
