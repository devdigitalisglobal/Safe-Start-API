{
    "name": "safe-start-api",
    "version": "1.0.0",
    "description": "Safe Start for Young Drivers — API",
    "type": "module",
    "main": "dist/src/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/src/server.js",
        "seed": "tsx prisma/seed.ts",
        "seed:dashboard-users": "tsx prisma/seed-dashboard-users.ts",
        "db:studio": "prisma studio",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "security:smoke": "tsx scripts/security-smoke.ts",
        "dashboard:contract": "tsx scripts/dashboard-contract-smoke.ts",
        "ops:generate-secrets": "tsx scripts/generate-production-secrets.ts",
        "postinstall": "node scripts/ensure-puppeteer-chrome.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/sensible": "^6.0.5",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@supabase/supabase-js": "^2.112.3",
        "dotenv": "^17.4.2",
        "fastify": "^5.11.3",
        "jose": "^6.2.8",
        "pg": "^8.23.0",
        "prisma": "^7.9.1",
        "puppeteer": "^25.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "pino-pretty": "^13.1.3",
        "tsx": "^4.23.12",
        "typescript": "~5.9.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "prisma@7.9.1": true,
        "@prisma/engines@7.9.1": true
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
